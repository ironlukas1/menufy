# Comma-separated browser origins allowed to call the API directly.
# The Vite dev server proxies /api to the backend, so local browser use does not need CORS.
CORS_ORIGINS=capacitor://localhost,ionic://localhost

# Supabase project connection (publishable or legacy anon key).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Existing public-schema table readable with this key for the read-only database check.
SUPABASE_HEALTH_TABLE=
