# Comma-separated browser origins allowed to call the API directly.
# The Vite dev server proxies /api to the backend, so local browser use does not need CORS.
CORS_ORIGINS=capacitor://localhost,ionic://localhost

# Add Supabase configuration when the database is introduced.
# Keep secret keys server-only; never add a NEXT_PUBLIC_ prefix to a secret.
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY= # only for trusted admin operations; this bypasses row-level security
