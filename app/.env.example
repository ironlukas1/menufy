# Copy to `.env.local` (git-ignored).
#
# Leave VITE_API_URL empty in development: Vite proxies /api to the Next.js
# server, so the browser sees a single origin and no CORS is involved.
VITE_API_URL=

# Target used by the dev proxy.
VITE_API_PROXY_TARGET=http://localhost:3001

# Optional identity sent as X-Menufy-User, matching the server's dev auth stub.
# Use a manager/admin address to exercise the write endpoints:
#   obed@bistromlyn.sk (manager) · admin@menufy.sk (admin)
VITE_API_USER=

# Supabase project, used by the browser-side client in `src/api/supabase.ts`.
# Use the publishable key: it is safe to ship, RLS protects the data.
# Never put the service_role / secret key here.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
