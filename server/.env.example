# ---------------------------------------------------------------------------
# Menufy API - environment
# Copy to `.env.local` (git-ignored) and adjust.
# ---------------------------------------------------------------------------

# Port is set by the npm scripts (`next dev --port 3001`).

# Where the API stores data.
#   memory   - in-memory store seeded from the prototype data (default)
#   supabase - PostgreSQL via Supabase (see ../server/supabase/README.md)
MENUFY_DATA_SOURCE=memory

# Supabase (only needed when MENUFY_DATA_SOURCE=supabase).
# The server talks to the database with the service-role key, so this file must
# never be shipped to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Dev identity until Supabase Auth is wired up.
# The PWA may send `X-Menufy-User: <email>`; otherwise this address is used.
MENUFY_DEV_USER=zuzana@example.sk

# Comma-separated lists used by the dev auth stub (roles for write endpoints).
MENUFY_ADMIN_EMAILS=admin@menufy.sk
MENUFY_MANAGER_EMAILS=obed@bistromlyn.sk

# Origins allowed to call the API from a browser.
# Vite dev server + Capacitor (Android/iOS) webviews.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,capacitor://localhost,ionic://localhost,https://localhost,http://localhost
